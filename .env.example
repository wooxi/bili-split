# ==============================================================================
# BiliSplit - Linux 服务端环境变量配置文件模板
# ==============================================================================

# 服务监听地址与端口 (0.0.0.0 允许局域网外部设备访问)
HOST=0.0.0.0
PORT=8000

# 音乐输出专属目录 (在 LXC 容器中建议挂载外部 NAS / 宿主盘)
MUSIC_DIR=/music

# 缓存与数据存储目录
TEMP_DIR=/tmp/bili-music
DATA_DIR=./data

# 音频优化开关 (工业级 EBU R128 响度标准化 & 首尾 0.3s 平滑淡入淡出)
ENABLE_LOUDNORM=true
ENABLE_FADE=true

# AI 大模型网关配置 (用于智能规范复杂歌名/翻唱/风格词剔除)
AI_API_BASE=http://192.168.100.4:8030/v1
AI_API_KEY=sk-xxbtN694lmzolOd4gPGLoREzYrwLroLxzhjZ3oD0wJ8D1C75
AI_MODEL=gemini-3.8-flash
